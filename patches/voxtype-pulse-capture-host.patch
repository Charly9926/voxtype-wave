+/// Pick the capture host.
+///
+/// The ALSA host only sees ALSA PCMs (`default`, `pipewire`, `sysdefault:...`),
+/// so a PipeWire source name such as `easyeffects_source` fails with "device not
+/// found". The Pulse host (served by pipewire-pulse) sees the PipeWire sources by
+/// name, which is what other applications such as Discord offer. Prefer it when
+/// it has a default input and fall back to the platform default host otherwise,
+/// so a machine without a sound server keeps working exactly as before.
+pub(crate) fn capture_host() -> cpal::Host {
+    use cpal::traits::HostTrait;
+
+    for id in cpal::available_hosts() {
+        if !id.name().eq_ignore_ascii_case("pulseaudio") {
+            continue;
+        }
+        match cpal::host_from_id(id) {
+            Ok(host) if host.default_input_device().is_some() => {
+                tracing::info!("Audio host: {}", id.name());
+                return host;
+            }
+            Ok(_) => tracing::debug!("Pulse host has no default input; using the default host"),
+            Err(e) => tracing::debug!("Pulse host unavailable: {e}"),
+        }
+    }
+    cpal::default_host()
+}
